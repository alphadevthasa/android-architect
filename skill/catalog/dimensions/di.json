{
  "id": "di",
  "name": "Dependency injection",
  "entries": [
    {
      "id": "manual-servicelocator",
      "name": "Manual wiring or service locator",
      "era": 1,
      "status": "legacy",
      "since": "2008",
      "successors": [
        "dagger2",
        "koin"
      ],
      "detect": {
        "content": [
          {
            "glob": "**/*.{java,kt}",
            "regex": "(object|class)\\s+\\w*ServiceLocator\\b|\\bServiceLocator\\."
          }
        ]
      }
    },
