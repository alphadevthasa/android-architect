        ]
      }
    },
    {
      "id": "contentprovider",
      "name": "ContentProvider-backed storage",
      "era": 1,
      "status": "legacy",
      "since": "2008",
      "successors": [
        "room"
      ],
      "detect": {
        "content": [
          {
            "glob": "**/*.{java,kt}",
            "regex": "(extends|:)\\s*ContentProvider\\b"
          }
        ]
      }
    },
