{
  "id": "build-performance",
  "name": "Build performance",
  "entries": [
    {
      "id": "config-cache",
      "name": "Gradle configuration cache",
      "era": 4,
      "status": "current",
      "since": "2021-11",
      "successors": [],
      "detect": {
        "content": [
          {
            "glob": "**/gradle.properties",
            "regex": "^\\s*org\\.gradle\\.(unsafe\\.)?configuration-cache\\s*=\\s*true\\s*$"
          }
        ]
      }
    },
    {
      "id": "build-cache",
      "name": "Gradle build cache",
      "era": 3,
      "status": "current",
      "since": "2017-04",
      "successors": [],
      "detect": {
        "content": [
          {
            "glob": "**/gradle.properties",
            "regex": "^\\s*org\\.gradle\\.caching\\s*=\\s*true\\s*$"
          }
        ]
      }
    },
    {
